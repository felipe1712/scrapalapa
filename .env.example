# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL (Si no hay conexión externa activa, usa motor PostgreSQL embebido PGlite persistente en ./data/pgdata)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrapper_db

# Clave maestra para cifrar API keys en BD con AES-256-GCM (32 bytes en hex = 64 caracteres)
ENCRYPTION_KEY=4f8a9b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcd

# Valores semilla (SEED) iniciales — solo se leen la primera vez si la tabla llm_settings está vacía
LLM_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
LLM_DEFAULT_MODEL=claude-3-5-sonnet-latest
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
LLM_MAX_INPUT_CHARS=120000
